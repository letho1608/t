{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "T",
  "scopeName": "source.t",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#fstrings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.t",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.t",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.t", "match": "\\\\([nrt\\\\\"']|u[0-9a-fA-F]{4})" }
          ]
        },
        {
          "name": "string.quoted.single.t",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.t", "match": "\\\\([nrt\\\\\"']|u[0-9a-fA-F]{4})" }
          ]
        }
      ]
    },
    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.t",
          "begin": "f(\"|')",
          "end": "\\1",
          "patterns": [
            {
              "name": "constant.character.escape.t",
              "match": "\\\\([nrt\\\\\"']|\\{|\\})"
            },
            {
              "name": "meta.interpolation.t",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.t",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.t",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.t",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.t",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.t",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.t",
          "match": "\\b(if|elif|else|for|in|while|break|continue|return|try|except|finally|raise|assert|switch|case|default)\\b"
        },
        {
          "name": "keyword.declaration.t",
          "match": "\\b(let|mut|fn|struct)\\b"
        },
        {
          "name": "keyword.control.import.t",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "keyword.operator.logical.t",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.t",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.t",
          "match": "\\b(print|len|range|str|int|float|type|tensor|open|read|write|close|ord|chr|argv|mem|f64bits|abs|round|min|max|sum|any|all|sort|reversed|enumerate|zip|map|filter|set|input|zeros|ones|full|arange|eye|rand|randn|seed|sqrt|exp|log|sin|cos|tanh|floor|ceil|pi|load)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.t",
          "match": "(<<=|>>=|&=|\\|=|\\^=|<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.t",
          "match": "(\\+=|-=|\\*=|/=|%=|\\*\\*|\\+|-|\\*|/|%|@)"
        },
        {
          "name": "keyword.operator.comparison.t",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.t",
          "match": "(=)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.t" }
          }
        }
      ]
    }
  }
}
