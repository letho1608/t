{
  "name": "t-lang",
  "displayName": "T Programming Language",
  "description": "Rich language support and syntax highlighting for the T programming language",
  "version": "3.1.0",
  "publisher": "t-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "t",
        "aliases": [
          "T",
          "tlang"
        ],
        "extensions": [
          ".t"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "t",
        "scopeName": "source.t",
        "path": "./syntaxes/t.tmLanguage.json"
      }
    ]
  }
}
